# Reverse proxy TLS sobre IPv6 para exponer FastAPI hacia el frontend en Firebase Hosting.
# Reemplaza api.tu-dominio.com por tu dominio con registro AAAA apuntando a tu PC/VM.
api.tu-dominio.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000 {
        # Evita buffering en SSE (/api/projects/{pid}/events)
        flush_interval -1
    }
}
